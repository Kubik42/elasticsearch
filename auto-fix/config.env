# Single configuration file for the auto-fix prototype: every tunable in ONE place. Plain KEY=value data, one per line
# (this is not a script). lib.sh loads it and applies each entry as a DEFAULT, only when the variable is unset, so an
# environment override always wins: the GitHub Actions env block, a CI input, or a one-off `VAR=... bash auto-fix/<step>.sh`
# all take precedence over the values here. To change a default permanently, edit it below.
#
# Format: blank lines and lines starting with # are ignored; everything after the first = is the literal value to end of
# line (no shell expansion or quoting), so commas and > in a label list are fine. Two settings with values derived from
# others - AUTOFIX_WORK (under the run dir) and AUTOFIX_PR_HEAD_OWNER (defaults to ASSIGNEE) - are computed in lib.sh;
# add them here to pin an explicit value.

# Identity & target: repo the PR is opened on / whose issues are searched, assigned, commented; and the claim login.
GH_REPO=elastic/elasticsearch
ASSIGNEE=Kubik42

# Run mode: 1 suppresses every GitHub mutation (assign, comment, branch push, PR).
AUTOFIX_DRY_RUN=0

# Step 1 discovery: how many newest candidate issues to pull before clustering by fix locus.
AUTOFIX_DISCOVER_LIMIT=50

# Step 2 base preparation: the pipeline runs inside a DEDICATED git worktree pinned to upstream main, so the user's main
# checkout is never touched and they can keep working during a run. AUTOFIX_UPSTREAM_REMOTE is the git remote tracking
# elastic/elasticsearch (run `git remote -v` to confirm its name) and AUTOFIX_UPSTREAM_BRANCH the branch; reproduce.sh
# fetches it and creates-or-resets AUTOFIX_RUN_BRANCH at <remote>/<branch> inside the worktree. AUTOFIX_TREE is the
# worktree path (empty -> a sibling of the repo, computed in lib.sh); AUTOFIX_KEEP_TREE=1 keeps it between runs for a warm
# Gradle cache (0 removes it at run end). AUTOFIX_SKIP_JAVA_GATE=1 skips the -Druntime.java=N -> JAVA${N}_HOME pre-flight.
AUTOFIX_UPSTREAM_REMOTE=elasticsearch_main
AUTOFIX_UPSTREAM_BRANCH=main
AUTOFIX_RUN_BRANCH=auto-fix/working-base
AUTOFIX_TREE=
AUTOFIX_KEEP_TREE=1
AUTOFIX_SKIP_JAVA_GATE=0

# JDK toolchains for the -Druntime.java=N gate (reproduce.sh resolves JAVA${N}_HOME). lib.sh exports these to every step,
# so they satisfy the gate for both manual and scheduled runs; a shell-set value still wins. JAVA26_HOME is pinned to the
# real JDK 26 keg (NOT the floating /opt/homebrew/opt/openjdk, which would drift to a newer major); re-point on a brew
# upgrade. Only 17/21/26 are genuinely installed here - do not add JAVA24/25_HOME from the fake openjdk@24/@25 symlinks.
JAVA26_HOME=/opt/homebrew/Cellar/openjdk/26.0.1/libexec/openjdk.jdk/Contents/Home

# Step 3 agents: wall-clock (seconds) and dollar caps per agent. AUTOFIX_FIX_MODEL overrides the claude model for both
# (empty = CLI default). AUTOFIX_SKIP_GOAL2=1 skips the collateral full-project run. AUTOFIX_MAX_FIX_LINES caps changed
# lines (excluding muted-tests.yml); over it trips the diff guard -> GAVE_UP.
AUTOFIX_FIX_BUDGET_SECONDS=2700
AUTOFIX_FIX_BUDGET_USD=20
AUTOFIX_VERIFY_BUDGET_SECONDS=900
AUTOFIX_VERIFY_BUDGET_USD=10
AUTOFIX_FIX_MODEL=
AUTOFIX_SKIP_GOAL2=0
AUTOFIX_MAX_FIX_LINES=20

# Step 3 PR push & target: default is the contributor cross-repo flow - push the fix branch to the user's FORK remote
# (must exist locally) and open the PR on the upstream GH_REPO. AUTOFIX_PR_BASE is the base branch. AUTOFIX_PUSH_BASE=1
# pins the diff via a dedicated base branch (SAME-REPO only). AUTOFIX_PR_LABELS must exist in GH_REPO; set empty for none.
AUTOFIX_PUSH_REMOTE=fork
AUTOFIX_PR_BASE=main
AUTOFIX_PUSH_BASE=0
AUTOFIX_PR_LABELS=Team:StorageEngine,>non-issue
